/dts-v1/;
#include "hi3798mv100.dtsi"

/ {
	model = "Huawei EC6108V9C";

	compatible = "hisilicon,hi3798mv100-ec6108v9c",
		     "hisilicon,hi3798mv100";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * fastboot leaves its logo/upgrade buffers here and the VO
		 * keeps DMA-ing them while the kernel boots; keep the
		 * allocator away from that window.
		 */
		fastboot-cma@3f000000 {
			reg = <0x3f000000 0x1000000>;
			no-map;
		};
	};

	leds {
		compatible = "gpio-leds";

		network {
			label = "green:network";
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		network-activity {
			label = "red:network";
			gpios = <&gpio2 2 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		ir {
			label = "green:ir";
			gpios = <&gpio5 2 GPIO_ACTIVE_HIGH>;
			panic-indicator;
			default-state = "off";
		};
	};
};

&emmc_data {
	pinctrl-single,bias-pulldown = <
		PINCTRL_PULLDOWN(0, 1, 0, 1)
	>;
	pinctrl-single,slew-rate = <
		PINCTRL_SLEW_RATE(1, 1)
	>;
	pinctrl-single,drive-strength = <
		PINCTRL_DRV_STRENGTH(6, 7)
	>;
};

&emmc_detect {
	pinctrl-single,bias-pulldown = <
		PINCTRL_PULLDOWN(0, 1, 0, 1)
	>;
	pinctrl-single,slew-rate = <
		PINCTRL_SLEW_RATE(1, 1)
	>;
	pinctrl-single,drive-strength = <
		PINCTRL_DRV_STRENGTH(3, 3)
	>;
};

&emmc_ccmd {
	pinctrl-single,bias-pullup = <
		PINCTRL_PULLUP(0, 1, 0, 1)
	>;
	pinctrl-single,slew-rate = <
		PINCTRL_SLEW_RATE(1, 1)
	>;
	pinctrl-single,drive-strength = <
		PINCTRL_DRV_STRENGTH(6, 7)
	>;
};

&emmc_cclk_out {
	pinctrl-single,bias-pulldown = <
		PINCTRL_PULLDOWN(0, 1, 0, 1)
	>;
	pinctrl-single,slew-rate = <
		PINCTRL_SLEW_RATE(1, 1)
	>;
	pinctrl-single,drive-strength = <
		PINCTRL_DRV_STRENGTH(5, 7)
	>;
};

&emmc_rst {
	pinctrl-single,bias-pullup = <
		PINCTRL_PULLUP(0, 1, 0, 1)
	>;
	pinctrl-single,slew-rate = <
		PINCTRL_SLEW_RATE(1, 1)
	>;
	pinctrl-single,drive-strength = <
		PINCTRL_DRV_STRENGTH(3, 3)
	>;
};

&timer1 {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&gpio0 {
	gpio-ranges = <
		&pmx0 2 10 1
		&pmx0 3 79 1
		&pmx0 4 21 4
	>;
	status = "okay";
};

&gpio2 {
	gpio-ranges = <
		&pmx0 0 25 1
		&pmx0 1 54 1
		&pmx0 2 55 2
	>;
	status = "okay";
};

&gpio4 {
	gpio-ranges = <
		&pmx0 0 80 2
	>;
	status = "okay";
};

&gpio5 {
	status = "okay";
};

&gpio6 {
	gpio-ranges = <
		&pmx0 0 82 2
	>;
	status = "okay";
};

&emmc {
	fifo-depth = <256>;
	clock-frequency = <100000000>;
	cap-mmc-highspeed;

	/*
	 * EC6108V9C: eMMC (H8G4a, 8 GB) is an 8-bit part.  Without "bus-width"
	 * mmc_of_parse() assumes 1 bit and mmc_validate_host_caps() then warns
	 * "drop UHS/DDR/HS200 support since 1-bit bus only" -- measured 2 MB/s.
	 *
	 * Stage 1: 8-bit data bus + high-speed timing only (3.3 V I/O, 52 MHz).
	 * The 1.8 V modes (mmc-ddr-1_8v / mmc-hs200-1_8v) are deliberately left
	 * out: the board has no vqmmc regulator and switching the rail blind
	 * risks a non-booting card.
	 */
	bus-width = <8>;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_data>, <&emmc_ccmd>, <&emmc_cclk_out>, <&emmc_rst>;

	non-removable;
	status = "okay";
};

&eth0 {
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ehci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&ir {
	status = "okay";
};

/*
 * No ddc-i2c-bus: the EDID is read through the transmitter's own DDC master
 * (the SDK does the same in si_mddc.c), so the HDMI block keeps the DDC
 * pins.  An external bit-banging adapter on them could only win the race
 * when it probed after the HDMI block, and every read failed once it did.
 */
&hdmi {
	status = "okay";
};

&vo {
	status = "okay";
};

&aiao {
	status = "okay";
};

/ {
	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "hi3798mv100-hdmi";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <256>;
		simple-audio-card,bitclock-master = <&hdmi_cpu>;
		simple-audio-card,frame-master = <&hdmi_cpu>;
		hdmi_cpu: simple-audio-card,cpu {
			sound-dai = <&aiao>;
		};
		simple-audio-card,codec {
			sound-dai = <&hdmi>;
		};
	};
};

&sd {
	/*
	 * EC6108V9C SD slot (SDIO0, dw-mshc).  Without bus-width the core falls
	 * back to 1 bit and without cap-sd-highspeed it stays at 25 MHz default
	 * speed -- measured ~2 MB/s.
	 *
	 * The SoC's SDIO0 clock mux only offers 15/50/75/100 MHz, so 50 MHz x
	 * 4 bit = 25 MB/s is the realistic ceiling.  UHS-I (SDR50/SDR104) is
	 * deliberately not declared: it needs 1.8 V signalling and this board
	 * runs a fixed 12 V -> 3.3 V rail.
	 */
	bus-width = <4>;
	cap-sd-highspeed;
	max-frequency = <50000000>;
	status = "okay";
};

/* --- EC6108V9C: enable the two INNO USB2 PHYs (required by ehci0/ohci0/ehci1/ohci1) --- */
&usb2_phy1 {
	status = "okay";
};

&usb2_phy2 {
	status = "okay";
};

/* --- 固定 MMC 编号：eMMC = mmcblk0，SD 槽 = mmcblk1（否则探测器顺序会漂移）--- */
/ {
	aliases {
		mmc0 = &emmc;
		mmc1 = &sd;
	};
};
